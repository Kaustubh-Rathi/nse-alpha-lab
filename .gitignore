# ============================================================================
# NSE Alpha Lab — public repository ignore rules
# ============================================================================

# ---------------------------------------------------------------------------
# Data. Never committed: the data pack is a separate, versioned, checksummed
# archive. Public release is pending; see docs/PUBLISH.md and DATA_LICENSES.md.
# ---------------------------------------------------------------------------
data/

# ---------------------------------------------------------------------------
# Binary data artefacts, anywhere in the tree
# ---------------------------------------------------------------------------
*.parquet
*.duckdb
*.duckdb.wal
*.pdf
*.zip

# ---------------------------------------------------------------------------
# Run output and logs
# ---------------------------------------------------------------------------
*.log
apps/lab/runs/

# ---------------------------------------------------------------------------
# Python environments and bytecode
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.so

# ---------------------------------------------------------------------------
# Test and tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Build artefacts. Root-anchored on purpose: a bare `build/` would also match
# the real source package src/nse_pipeline/build/, silently dropping it from
# every commit (caught by CI: ModuleNotFoundError: nse_pipeline.build).
# ---------------------------------------------------------------------------
/build/
/dist/
*.egg-info/
.eggs/
src/*.egg-info/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Editor
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*~

# ---------------------------------------------------------------------------
# Local environment overrides and secrets. Never commit real credentials,
# tokens, emails or absolute paths to a broker or vendor.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Local scratch
# ---------------------------------------------------------------------------
scratch/
.tmp/
*.tmp

# Internal results (pre-transform), kept local only
*.internal.csv
# pytest temp dirs locked by the conftest audit hook
pytest-cache-files-*/
# Local scratch from redirecting USERPROFILE/TMP for the Windows suite
.testhome*/
.testtmp*/
.testcopy/
pytest-of-*/
/tmp*.jsonl

# Synthetic mechanics demo output (regenerated by build_pack.py)
examples/synthetic_demo/pack/
examples/synthetic_demo/result.json

# Export bookkeeping (local only)
.export-manifest.json

# Video narration WAVs, per-scene SRTs and the web encode are build/upload
# intermediates; the published MP4, GIF, poster, SRT and caption JSON are the
# artifacts. Rebuild them with docs/assets/video/tts.py and
# docs/assets/video/render_video.py.
docs/assets/video/audio/
docs/assets/video/subs/
docs/assets/video/demo-web.mp4
